{
  "manifest_version": 3,
  "name": "Privacy Detector",
  "version": "0.3.0",
  "description": "Firefox extension for detecting web trackers and privacy threats.",
  "permissions": [
    "tabs",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background/background.js"
    ]
  },
  "action": {
    "default_title": "Privacy Detector",
    "default_popup": "popup/popup.html"
  }
}