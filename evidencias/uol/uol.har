bute(\"style\", SMALL_IMAGE_STYLE);\\n      } else {\\n        title.style.fontSize = \"20px\";\\n        image.setAttribute(\"style\", LARGE_IMAGE_STYLE);\\n        content.style.display = \"flex\";\\n        content.style.justifyContent = \"center\";\\n      }\\n      function fitText() {\\n        var maxSize = Math.round(content.clientHeight * 0.13);\\n        var size = Math.min(20, Math.max(11, maxSize));\\n        while (size > 9) {\\n          if (content.scrollHeight <= content.clientHeight) break;\\n          size -= 1;\\n        }\\n      }\\n      fitText();\\n      window.addEventListener(\"resize\", fitText);\\n      const listMacros = [\\n        \"\",\\n        \"\",\\n        \"\",\\n        \"\",\\n        \"\",\\n      ];\\n      let iframeDiv;\\n      let iframeDiv2;\\n      let intervalDiv = setInterval(() => {\\n        iframeDiv = top.document.querySelector(\\n          \"#banner-native-home-area iframe\",\\n        );\\n        iframeDiv2 = top.document.querySelector(\\n          \"#banner-native-home-area-2 iframe\",\\n        );\\n        if (iframeDiv) {\\n          iframeDiv.style.width = \"100%\";\\n          iframeDiv.style.height = \"100%\";\\n          if (isMobile()) {\\n            iframeDiv.style.minHeight = \"176px\";\\n          } else {\\n            iframeDiv.style.minHeight = \"180px\";\\n\\n          }\\n        }\\n        if (iframeDiv2) {\\n          iframeDiv2.style.width = \"100%\";\\n          iframeDiv2.style.height = \"100%\";\\n          if (isMobile()) {\\n            iframeDiv2.style.minHeight = \"176px\";\\n          } else {\\n            iframeDiv2.style.minHeight = \"180px\";\\n\\n          }\\n        }\\n\\n        clearInterval(intervalDiv);\\n      }, 100);\\n\\n      const i = setInterval(() => {\\n        var adItem = window.top.document.querySelector(\".headlineHorizontalAd\");\\n        if (adItem !== null) {\\n          adItem.addEventListener(\"click\", () => {\\n            listMacros.forEach((pixel)